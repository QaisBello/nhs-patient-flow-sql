/// Treatment function codes (NHS Data Dictionary).
table Specialty
	lineageTag: d7310239-0887-4720-854a-972cf303b884

	column treatment_function
		dataType: string
		isHidden
		isKey
		lineageTag: e3dd4c1b-8120-4498-8840-5572e949efab
		summarizeBy: none
		sourceColumn: treatment_function

	column description
		dataType: string
		lineageTag: 604fb1a8-1b41-448f-8538-d898847890a6
		summarizeBy: none
		sourceColumn: description

	partition Specialty = m
		mode: import
		source =
				let
				    Source = Csv.Document(
				        Web.Contents(BaseUrl, [RelativePath = "ref_treatment_function.csv"]),
				        [Delimiter = ",", Encoding = 65001, QuoteStyle = QuoteStyle.Csv]
				    ),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars = true]),
				    // empty cells and R's NA arrive as text and would fail the type change: make them null
				    #"Blanks to Null" = Table.TransformColumns(#"Promoted Headers", {}, each if _ = "" or _ = "NA" then null else _),
				    #"Changed Types" = Table.TransformColumnTypes(
				        #"Blanks to Null",
				        {
				            {"treatment_function", type text},
				            {"description", type text}
				        },
				        "en-US"
				    ),
				    #"Filtered Rows" = #"Changed Types",
				    Result = #"Filtered Rows"
				in
				    Result

