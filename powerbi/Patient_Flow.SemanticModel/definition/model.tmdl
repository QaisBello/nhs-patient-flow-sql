model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	discourageImplicitMeasures
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Spells","Patients","Deprivation","Age Bands","Population","Specialty","Date","BaseUrl"]

annotation PBI_ProTooling = ["DevMode"]

ref table Spells
ref table Patients
ref table Deprivation
ref table 'Age Bands'
ref table Population
ref table Specialty
ref table Date

ref cultureInfo en-GB

