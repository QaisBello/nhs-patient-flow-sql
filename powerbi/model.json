  "measures": [
    {
      "name": "Spells Count",
      "table": "Spells",
      "folder": "Activity",
      "format": "#,0",
      "dax": "COUNTROWS ( Spells )",
      "description": "Hospital stays (spells), counted on admission date."
    },
    {
      "name": "Emergency Admissions",
      "table": "Spells",
      "folder": "Activity",
      "format": "#,0",
      "dax": "CALCULATE ( [Spells Count], Spells[admission_group] = \"Emergency\" )",
      "description": "Emergency spells."
    },
    {
      "name": "Elective Admissions",
      "table": "Spells",
      "folder": "Activity",
      "format": "#,0",
      "dax": "CALCULATE ( [Spells Count], Spells[admission_group] = \"Elective\" )",
      "description": "Elective spells."
    },
    {
      "name": "Mean Length of Stay",
      "table": "Spells",
      "folder": "Length of stay",
      "format": "0.0",
      "dax": "CALCULATE ( AVERAGE ( Spells[los_days] ), NOT ISBLANK ( Spells[discharge_date] ) )",
      "description": "Mean days in hospital, discharged spells."
    },
    {
      "name": "Median Length of Stay",
      "table": "Spells",
      "folder": "Length of stay",
      "format": "0.0",
      "dax": "CALCULATE ( MEDIAN ( Spells[los_days] ), NOT ISBLANK ( Spells[discharge_date] ) )",
      "description": "Median days in hospital, discharged spells."
    },
    {
      "name": "Overnight Discharges",
      "table": "Spells",
      "folder": "Flow",
      "format": "#,0",
      "dax": "CALCULATE ( [Spells Count], USERELATIONSHIP ( Spells[discharge_date], 'Date'[Date] ), Spells[los_days] > 0 )",
      "description": "Overnight stays counted on their discharge date instead of admission date (the inactive relationship), as sql/q08.sql."
    },
    {
      "name": "Discharges per Day",
      "table": "Spells",
      "folder": "Flow",
      "format": "0.0",
      "dax": "DIVIDE ( [Overnight Discharges], COUNTROWS ( 'Date' ) )",
      "description": "Average discharges per calendar day in context."
    },
    {
      "name": "Bed Base",
      "table": "Spells",
      "folder": "Beds",
      "format": "#,0",
      "dax": "170",
      "description": "General and acute beds, as in the SQL."
    },
    {
      "name": "Beds Occupied at Midnight",
      "table": "Spells",
      "folder": "Beds",
      "format": "#,0",
      "dax": "VAR _d = MAX ( 'Date'[Date] )\nRETURN\n    CALCULATE (\n        [Spells Count],\n        REMOVEFILTERS ( 'Date' ),\n        Spells[admission_date] <= _d,\n        ISBLANK ( Spells[discharge_date] ) || Spells[discharge_date] > _d\n    )",
      "description": "Patients in a bed at midnight on the last day in context: admitted on or before it and not yet discharged."
    },
    {
      "name": "Average Beds Occupied",
      "table": "Spells",
      "folder": "Beds",
      "format": "0.0",
      "dax": "AVERAGEX (\n    CALCULATETABLE ( VALUES ( 'Date'[Date] ), 'Date'[Occupancy Counted] = 1 ),\n    [Beds Occupied at Midnight]\n)",
      "description": "Average of the nightly counts, from June 2024."
    },
    {
      "name": "Bed Occupancy",
      "table": "Spells",
      "folder": "Beds",
      "format": "0.0%",
      "dax": "DIVIDE ( [Average Beds Occupied], [Bed Base] )",
      "description": "Average midnight occupancy against the bed base."
    },
    {
      "name": "Peak Beds Occupied",
      "table": "Spells",
      "folder": "Beds",
      "format": "#,0",
      "dax": "MAXX (\n    CALCULATETABLE ( VALUES ( 'Date'[Date] ), 'Date'[Occupancy Counted] = 1 ),\n    [Beds Occupied at Midnight]\n)",
      "description": "Fullest night in context."
    },
    {
      "name": "Nights Over 95%",
      "table": "Spells",
      "folder": "Beds",
      "format": "#,0",
      "dax": "COUNTROWS (\n    FILTER (\n        CALCULATETABLE ( VALUES ( 'Date'[Date] ), 'Date'[Occupancy Counted] = 1 ),\n        [Beds Occupied at Midnight] > 0.95 * [Bed Base]\n    )\n)",
      "description": "Nights above 95% occupancy, the level at which flow suffers."
    },
    {
      "name": "95% Line",
      "table": "Spells",
      "folder": "Beds",
      "format": "0%",
      "dax": "0.95",
      "description": "Reference line for charts."
    },
    {
      "name": "Readmission Rate (30 days)",
      "table": "Spells",
      "folder": "Readmissions",
      "format": "0.0%",
      "dax": "DIVIDE ( SUM ( Spells[Readmitted 30d] ), SUM ( Spells[Is Index Spell] ) )",
      "description": "Index spells followed by an emergency admission within 30 days of discharge."
    },
    {
      "name": "Emergency Admissions per Year",
      "table": "Spells",
      "folder": "Inequalities",
      "format": "#,0.0",
      "dax": "DIVIDE ( [Emergency Admissions], CALCULATE ( DISTINCTCOUNT ( 'Date'[Financial Year] ), REMOVEFILTERS ( 'Date' ) ) )",
      "description": "Emergency admissions divided by the years of data (2)."
    },
    {
      "name": "Population Count",
      "table": "Spells",
      "folder": "Inequalities",
      "format": "#,0",
      "dax": "SUM ( Population[population] )",
      "description": "Catchment population in context."
    },
    {
      "name": "Crude Rate per 1,000",
      "table": "Spells",
      "folder": "Inequalities",
      "format": "0.0",
      "dax": "DIVIDE ( 1000 * CALCULATE ( [Emergency Admissions per Year], NOT ISBLANK ( Patients[imd_quintile] ) ), [Population Count] )",
      "description": "Emergency admissions per 1,000 population a year, not adjusted for age."
    },
    {
      "name": "Age-Standardised Rate per 1,000",
      "table": "Spells",
      "folder": "Inequalities",
      "format": "0.0",
      "dax": "VAR _bands =\n    ADDCOLUMNS (\n        VALUES ( 'Age Bands'[age_band] ),\n        \"@w\", CALCULATE ( MAX ( 'Age Bands'[esp2013_weight] ) ),\n        \"@pop\", [Population Count],\n        \"@events\", CALCULATE ( [Emergency Admissions per Year], NOT ISBLANK ( Patients[imd_quintile] ) )\n    )\nVAR _rated = FILTER ( _bands, [@pop] > 0 )\nRETURN\n    DIVIDE ( SUMX ( _rated, DIVIDE ( 1000 * [@events], [@pop] ) * [@w] ), SUMX ( _rated, [@w] ) )",
      "description": "Directly age-standardised to the 2013 European Standard Population: band rates weighted by ESP and averaged."
    },
    {
      "name": "Deprivation Gap",
      "table": "Spells",
      "folder": "Inequalities",
      "format": "0.0\"x\"",
      "dax": "DIVIDE (\n    CALCULATE ( [Age-Standardised Rate per 1,000], Deprivation[imd_quintile] = 1 ),\n    CALCULATE ( [Age-Standardised Rate per 1,000], Deprivation[imd_quintile] = 5 )\n)",
      "description": "Most deprived fifth against least deprived fifth, age-standardised."
    }
  ],
